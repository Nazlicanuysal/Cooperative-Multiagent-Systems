<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="rob_one">

    <!-- Evrensel İsim Uzayı (Namespace) Ön Eki -->
    <xacro:arg name="prefix" default="" />

    <!-- 1. TEMEL MEKANİK BİLEŞENLER -->
    <xacro:include filename="robot_core.xacro" />
    
    <!-- 2. SENSÖRLER  -->
    <xacro:include filename="lidar.xacro" />
    <!-- <xacro:include filename="depth_camera.xacro" /> -->

    <!-- 3. SİMÜLASYON KONTROL EKLENTİLERİ (GAZEBO) -->
    <xacro:include filename="gazebo_control.xacro" />

</robot>